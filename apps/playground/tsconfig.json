{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "leaflet-scribe": ["../../packages/leaflet-scribe/src/index.ts"],
      "leaflet-scribe/core": ["../../packages/leaflet-scribe/src/index.ts"],
      "leaflet-scribe/react": ["../../packages/leaflet-scribe/src/react.ts"]
    }
  },
  "include": ["src"]
}
